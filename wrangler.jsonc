{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "quick-ai-setup",
  // Static-assets-only Worker: no "main" script. Vite builds into ./dist.
  "compatibility_date": "2026-09-23",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    { "pattern": "ai.creativecodecampus.com", "custom_domain": true },
    // The zone has a wildcard route (*.creativecodecampus.com/* -> praxis-demos) that
    // captures every subdomain first. This more specific route sends ai. to this Worker.
    { "pattern": "ai.creativecodecampus.com/*", "zone_name": "creativecodecampus.com" }
  ]
}
